# 大模型 API 配置（支持 DeepSeek 或任意 OpenAI 兼容接口）
DEEPSEEK_API_KEY=
# 可选：自定义接口地址与模型名（默认对接 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 语音合成 TTS API 配置（阿里云百炼 Qwen3-TTS-Flash，推荐）
DASHSCOPE_API_KEY=
# 可选：百炼 TTS 模型与默认音色（Cherry / Serena / Ethan / Chelsie）
BAILIAN_TTS_MODEL=qwen3-tts-flash
TTS_DEFAULT_VOICE=Cherry

# 可选：豆包 / 火山引擎 TTS（当未配百炼时可填以下参数）
DOUBAO_APPID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_CLUSTER=volcano_tts
DOUBAO_VOICE_TYPE=zh_male_M392_conversation_wvae_bigtts
